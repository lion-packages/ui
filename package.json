{
  "name": "@lion-npm/ui",
  "private": false,
  "version": "1.3.6",
  "description": "Web components for different environments.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lion-packages/ui.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "publish:build": "tsc -b && vite build --config vite.config.lib.ts",
    "publish": "npm run publish:build && npm publish --access public"
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor/core": "^8.5.3",
    "@tanstack/react-table": "^9.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "oxlint": "^1.88.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-bootstrap": "^2.10.10",
    "react-router-dom": "^7.18.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
